# NODEJS
NODE_ENV=development

# External connections
DATABASE_URL=postgresql://postgres:password@localhost:5432/wiredeck-manager
PORT=8080
FRONTEND_URL=http://localhost:5173

# The service related configs
SERVICE_NAME=wiredeck-manager
JWT_SECRET=your-secret-key-change-in-production
USERS=[{"username":"admin","password":"admin"},{"username":"user","password":"user"}]

# The deploying configuration
INSTANCE_START_IP=172.20.0.1
INSTANCE_START_PORT=51820
INSTANCE_INTERNAL_SUBNET=172.21.0.0/24
ROOT_DOMAIN=localhost
CERTBOT_EMAIL=your-email@example.com
MODULE_WEBVNC_PREFERED_NETWORK_ID=1
MODULE_WEBVIEW_PREFERED_NETWORK_ID=2