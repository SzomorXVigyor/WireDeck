{
  "name": "wiredeck",
  "version": "1.2.2",
  "description": "WireDeck is a self-hosted WireGuard VPN server manager. It is a web-based interface for managing WireGuard VPN servers. Able to attach extra service modules for VPN server instance.",
  "main": "./src/server.js",
  "repository": "https://github.com/SzomorXVigyor/WireDeck.git",
  "author": "SzomorXVigyor",
  "license": "MIT",
  "scripts": {
    "start": "node ./src/server.js",
    "start:docker": "node ./server.js",
    "dev": "nodemon ./src/server.js",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dockerode": "^4.0.12",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3"
  },
  "packageManager": "pnpm@10.33.0"
}
